# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored — never commit real secrets.

# Required: your DeepSeek (or OpenAI-compatible) API key
DEEPSEEK_API_KEY=

# Optional: API base URL (defaults to DeepSeek)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: model name (the UI shows whatever is configured here)
DEEPSEEK_MODEL=deepseek-v4-flash

# Server binding. Defaults: loopback only + port 8000.
# Set HOST=0.0.0.0 ONLY if you intentionally want LAN access (not recommended).
HOST=127.0.0.1
PORT=8000
